# Kopiera till .env och fyll i
# Imagen som GitHub bygger åt dig (byt till ditt repo-namn, bara små bokstäver)
APP_IMAGE=ghcr.io/nilsanton/moggade.spela
# Vilken version som ska köras. Samma nummer som i package.json. Byt tillbaka för att ångra.
APP_VERSION=1.0.0
TUNNEL_TOKEN=klistra-in-din-cloudflare-tunnel-token-här
KILL_LIMIT=25
MAX_PLAYERS=16
# Bottar: 0 = inga bottar (bara riktiga spelare). T.ex. 3 = fyller upp till 4 spelare. Svårighet: easy, normal eller hard
BOTS=0
BOT_SKILL=normal
# Discord-inloggning (valfritt, se README). Adressen spelet nås på, utan / på slutet.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_URL=https://fps.dindomän.se
GAME_PORT=3000

# ============================================================
# SPELVÄRDEN – skada, liv, förmågor, XP …
# Ta bort # i början av en rad och ändra siffran. Starta om spelet efteråt.
# Rader som börjar med # använder standardvärdet.
# ============================================================
#ROUND_MINUTES=8   # minuter per runda

# --- AUTOKARBIN ---
#AUTOKARBIN_SKADA=22   # skada per träff i kroppen (hagelgevär: per hagel)
#AUTOKARBIN_HUVUDSKADA=55   # skada per träff i huvudet
#AUTOKARBIN_MS_MELLAN_SKOTT=100   # millisekunder mellan skotten (lägre = snabbare)
#AUTOKARBIN_MAGASIN=30   # skott per magasin
#AUTOKARBIN_OMLADDNING_MS=1700   # hur lång tid omladdningen tar
#AUTOKARBIN_SKADA_TAPPAS_EFTER=0   # meter innan skadan börjar minska (0 = aldrig)
#AUTOKARBIN_SPRIDNING=0.012   # spridning utan att sikta
#AUTOKARBIN_SPRIDNING_SIKTE=0.002   # spridning när du siktar
#AUTOKARBIN_SPRIDNING_I_RORELSE=0.025   # extra spridning när du rör dig
#AUTOKARBIN_REKYL=0.011   # hur mycket vapnet sparkar uppåt
#AUTOKARBIN_ZOOM_FOV=55   # synfält när du siktar (lägre = mer zoom)

# --- SMG ---
#SMG_SKADA=14   # skada per träff i kroppen (hagelgevär: per hagel)
#SMG_HUVUDSKADA=30   # skada per träff i huvudet
