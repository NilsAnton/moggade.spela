#SMG_SPRIDNING_I_RORELSE=0.012   # extra spridning när du rör dig
#SMG_REKYL=0.006   # hur mycket vapnet sparkar uppåt
#SMG_ZOOM_FOV=62   # synfält när du siktar (lägre = mer zoom)

