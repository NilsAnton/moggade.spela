# Kopiera till .env och fyll i
# Imagen som GitHub bygger åt dig (byt till ditt repo-namn, bara små bokstäver)
APP_IMAGE=ghcr.io/nilsanton/moggade.spela
# Vilken version som ska köras. Samma nummer som i package.json. Byt tillbaka för att ångra.
APP_VERSION=1.0.0
TUNNEL_TOKEN=klistra-in-din-cloudflare-tunnel-token-här
KILL_LIMIT=25
MAX_PLAYERS=16
# Bottar fyller upp till BOTS+1 spelare. Svårighet: easy, normal eller hard
BOTS=3
BOT_SKILL=normal
GAME_PORT=3000
