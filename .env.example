# --- Förmågor och regler ---
#STIM_HP=40   # HP som Soldatens stim ger
#MARKSTOT_SKADA=50   # Tankens markstöt: skada mitt i (halva längst ut)
#MARKSTOT_RADIE=5   # markstötens radie i meter
#RADAR_MS=4000   # hur länge Spanarens radar varar
#PANSAR_MS=4000   # hur länge Fästningens pansar varar
#PANSAR_SKADA_PROCENT=50   # hur många procent skada man tar med pansar
#DASH_FART=22   # Löparens dash, m/s
#SUPERHOPP_KRAFT=13.5   # Skyttens superhopp (vanligt hopp är 7.6)
#RESPAWN_SEKUNDER=3   # väntetid innan du kommer tillbaka
#SPAWNSKYDD_SEKUNDER=1.5   # osårbar efter spawn (slutar när du skjuter)
#HEALPAD_HP=50   # HP som en hälsoplatta ger
#HEALPAD_SEKUNDER=20   # sekunder innan plattan går att ta igen
#GUNGAME_KILLS_PER_NIVA=2   # kills per vapen i Gun Game

# --- XP ---
#XP_KILL=100   # XP per kill
#XP_HEADSHOT=40   # extra XP för headshot-kill
#XP_MULTIKILL=50   # XP per extra kill i en multikill
#XP_SVIT=25   # XP × sviten (från 3 kills i rad)
#XP_VINST=500   # XP för att vinna rundan
#XP_RUNDA=150   # XP för att spela klart en runda
#XP_GUNGAME_NIVA=60   # XP för ny nivå i Gun Game
